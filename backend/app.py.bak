"""
MediQueue - Flask API for Symptom -> Specialist -> Doctor/Hospital suggestion
Run this locally to serve predictions to your frontend during demo.
"""

from flask import Flask, request, jsonify
from flask_cors import CORS
import joblib
import json
import numpy as np
import os


app = Flask(__name__)
CORS(app)

MODELS_DIR = os.path.join(os.path.dirname(__file__), 'models')


def model_path(filename):
    return os.path.join(MODELS_DIR, filename)


model = joblib.load(model_path('symptom_disease_model.pkl'))
le = joblib.load(model_path('label_encoder.pkl'))

with open(model_path('symptom_list.json'), 'r') as f:
    all_symptoms = json.load(f)

with open(model_path('disease_to_specialist.json'), 'r') as f:
    disease_to_specialist = json.load(f)

with open(model_path('doctor_hospital_data.json'), 'r') as f:
    doctor_hospital_data = json.load(f)


@app.route('/', methods=['GET'])
def index():
    return jsonify({
        "service": "Smart Care AI Symptom Engine",
        "status": "running",
        "message": "Trained symptoms are available at /symptoms and predictions at /predict",
        "symptoms_count": len(all_symptoms),
        "sample_symptoms": [
            "high_fever",
            "headache",
            "vomiting",
            "fatigue"
        ]
    })


@app.route('/symptoms', methods=['GET'])
def get_symptoms():
    return jsonify({"symptoms": all_symptoms})


@app.route('/predict', methods=['POST'])
def predict():
    data = request.get_json(silent=True) or {}
    input_symptoms = data.get('symptoms', [])

    if not isinstance(input_symptoms, list):
        return jsonify({"error": "Expected a JSON array of symptoms"}), 400

    normalized = [symptom.strip() for symptom in input_symptoms if isinstance(symptom, str) and str(symptom).strip()]

    if len(normalized) < 3:
        return jsonify({"error": "Please select at least 3 symptoms for accurate prediction"}), 400

    unknown = [s for s in normalized if s not in all_symptoms]
    if unknown:
        return jsonify({"error": f"Unrecognized symptoms: {unknown}"}), 400

    input_vector = [1 if s in normalized else 0 for s in all_symptoms]
    input_vector = np.array(input_vector).reshape(1, -1)

    probs = model.predict_proba(input_vector)[0]
    top_indices = np.argsort(probs)[::-1][:3]

    results = []
    for idx in top_indices:
        score = float(probs[idx])
        disease_name = le.inverse_transform([idx])[0].strip()
        specialist = disease_to_specialist.get(disease_name, "General Physician")
        doctors = doctor_hospital_data.get(specialist, [])
        results.append({
            "disease": disease_name,
            "specialist": specialist,
            "confidence": round(score * 100, 2),
            "doctors": doctors
        })

    if not results:
        fallback_disease = "Influenza"
        fallback_specialist = disease_to_specialist.get(fallback_disease, "General Physician")
        results = [{
            "disease": fallback_disease,
            "specialist": fallback_specialist,
            "confidence": 35.0,
            "doctors": doctor_hospital_data.get(fallback_specialist, [])
        }]

    return jsonify({"predictions": results})


if __name__ == '__main__':
    app.run(debug=True, port=5001)
