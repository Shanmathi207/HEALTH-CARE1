# Smart Care - Environment Configuration Template
# Copy this file to .env and enter your actual values.

# Database Configuration
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=healthcare

# PHP Authentication API
PHP_AUTH_API_URL=http://localhost/HEALTH-CARE(1)/HEALTH-CARE-main/backend/php_auth/index.php

# Node.js Application
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here