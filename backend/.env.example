# Smart Care - Database Connection Configuration Template
# Copy this file to .env and fill in your credentials

# Database Type
DB_TYPE=mongodb

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>

# PostgreSQL/MySQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=password
DB_NAME=smartcare_db

# Application Settings
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
